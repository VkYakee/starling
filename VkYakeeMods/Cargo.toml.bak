[package]
name = "vkyakee-mods"
version = "0.1.0"
edition.workspace = true
license.workspace = true
authors = ["VkYakee"]
description = "VkYakee Mod Framework and Hub for Starling Minecraft"

[features]
default = ["api"]
api = []

[dependencies]
seedcracker = { path = "seedcracker" }
horizonmatica = { path = "HorizonMatica" }
vlakee-ui = { path = "VlakeeUI" }
vkmap = { path = "VkMap" }
log = "0.4"
serde = { version = "1", features = ["derive"] }
serde_json = "1.0"

[dev-dependencies]
